          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'date',
              'month',
              'itemName',
              'category',
              'wastedAmount',
              'reason',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(wasteId) && hasValidParentProfile(userId);
      }

      // 6. Recipe Usages Subcollection
      match /recipeUsages/{usageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(usageId) && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
