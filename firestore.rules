          isValidRecipeUsageEntry(incoming(), userId, usageId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentProfile(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(usageId) &&
          isValidRecipeUsageEntry(incoming(), userId, usageId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'date',
              'month',
              'recipeTitle',
              'usedIngredients',
              'savedAmount',
              'memo',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(usageId) && hasValidParentProfile(userId);
      }

      // 7. Monthly AI Summaries Subcollection
      match /monthlySummaries/{monthId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidMonthStr(monthId) && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidMonthStr(monthId) &&
          isValidMonthlySummaryDoc(incoming(), userId, monthId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentProfile(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidMonthStr(monthId) &&
          isValidMonthlySummaryDoc(incoming(), userId, monthId) &&
          incoming().month == existing().month &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'headline',
              'summaryParagraph',
              'actionTips',
              'generatedAt',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidMonthStr(monthId) && hasValidParentProfile(userId);
      }

      // 8. Store Recommendations Subcollection
      match /storeRecommendations/{recId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(recId) && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(recId) &&
          isValidStoreRecommendationDoc(incoming(), userId, recId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentProfile(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(recId) &&
          isValidStoreRecommendationDoc(incoming(), userId, recId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'primaryRecommendedMall',
              'overallStrategy',
              'bundleShippingTip',
              'itemGuides',
              'sources',
              'priceDisclaimer',
              'generatedAt',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(recId) && hasValidParentProfile(userId);
      }

      // 9. Ingredient Lifecycle Events Subcollection
      match /lifecycleEvents/{eventId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(eventId) && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(eventId) &&
          isValidLifecycleEventDoc(incoming(), userId, eventId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentProfile(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(eventId) &&
          isValidLifecycleEventDoc(incoming(), userId, eventId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'causeTag',
              'note',
              'amountKRW',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(eventId) && hasValidParentProfile(userId);
      }

      // 10. Monthly Waste Cause AI Analyses Subcollection
      match /wasteAnalyses/{monthId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidMonthStr(monthId) && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidMonthStr(monthId) &&
          isValidWasteCauseAnalysisDoc(incoming(), userId, monthId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentProfile(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidMonthStr(monthId) &&
          isValidWasteCauseAnalysisDoc(incoming(), userId, monthId) &&
          incoming().month == existing().month &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'diagnosisHeadline',
              'primaryCauseSummary',
              'detectedPatterns',
              'tailoredSolutions',
              'recommendedBuyingRule',
              'analyzedEventCount',
              'generatedAt',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidMonthStr(monthId) && hasValidParentProfile(userId);
      }

      // 11. Mission Mini-Game Progress Subcollection
      match /gameProgress/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidMissionGameDoc(incoming(), userId, docId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentProfile(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidMissionGameDoc(incoming(), userId, docId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalPoints',
              'completedRounds',
              'completedMissionsCount',
              'roundNumber',
              'roundBonusClaimed',
              'activeMissions',
              'recentLogs',
              'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId) && hasValidParentProfile(userId);
      }
    }
  }
}
