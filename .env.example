# ============================================================================
# [SERVER-ONLY SECRETS] — 절대 VITE_ 접두사를 붙이거나 프런트엔드에 노출하지 마세요.
# ============================================================================

# GEMINI_API_KEY: Gemini AI 호출용 서버 전용 비밀 키 (server.ts에서만 참조).
# AI Studio 환경에서는 Settings > Secrets 패널에서 런타임에 자동 주입됩니다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 애플리케이션 호스팅 URL
APP_URL="MY_APP_URL"

# ALLOWED_OWNER_EMAIL: 서버 측 Gemini AI 호출을 허용할 추가 소유자 Google 이메일(선택, 쉼표 구분)
ALLOWED_OWNER_EMAIL="OWNER_GOOGLE_EMAIL"

# FIREBASE_PROJECT_ID: 서버 측 Firebase ID 토큰 검증용 프로젝트 ID (선택)
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# ============================================================================
# [OPTIONAL CLIENT FIREBASE CONFIG] — 외부/GitHub 배포 시 환경변수 주입용
# Firebase 웹 설정 키는 Google Cloud 콘솔에서 반드시 HTTP 리퍼러 및 API 제한을 설정하세요.
# ============================================================================
VITE_FIREBASE_API_KEY="YOUR_RESTRICTED_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

