{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Per-user kitchen preferences, monthly food budget, and allergy exclusions.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nickname": {
          "type": "string",
          "description": "Display nickname shown in header and dashboard.",
          "minLength": 1,
          "maxLength": 40
        },
        "householdLabel": {
          "type": "string",
          "description": "Household label description.",
          "minLength": 1,
          "maxLength": 80
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Monthly target food budget in KRW."
        },
        "allergiesAndDislikes": {
          "type": "array",
          "description": "Bounded list of up to 30 allergy or disliked ingredient strings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "userId",
        "nickname",
        "householdLabel",
        "monthlyBudget",
        "allergiesAndDislikes",
        "createdAt",
        "updatedAt"
      ]
    },
    "IngredientItem": {
      "title": "IngredientItem",
      "description": "Single ingredient stored in the user's refrigerator, freezer, or pantry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "maxLength": 20,
          "enum": ["채소", "과일", "육류", "해산물", "유제품", "알류", "곡류", "가공식품", "기타"]
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "storage": {
          "type": "string",
          "maxLength": 10,
          "enum": ["냉장", "냉동", "실온"]
        },
        "purchaseDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"
        },
        "hasPurchasePrice": {
          "type": "boolean"
        },
        "purchasePrice": {
          "type": "number"
        },
        "memo": {
          "type": "string",
          "maxLength": 300
        },
        "isSample": {
          "type": "boolean"
        },
        "clientCreatedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "category",
        "quantity",
        "unit",
        "storage",
        "purchaseDate",
        "expiryDate",
        "hasPurchasePrice",
        "purchasePrice",
        "memo",
        "isSample",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
