  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile and preferences document owned by {userId}."
    },
    "/users/{userId}/ingredients/{ingredientId}": {
      "schema": "IngredientItem",
      "description": "User's refrigerator, freezer, and pantry ingredients."
    },
    "/users/{userId}/recipes/{recipeId}": {
      "schema": "SavedRecipe",
      "description": "User's AI-recommended recipes."
    },
    "/users/{userId}/shoppingItems/{itemId}": {
      "schema": "ShoppingListItem",
      "description": "User's shopping list items."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "ExpenseEntry",
      "description": "User's food expense records."
    },
    "/users/{userId}/wastes/{wasteId}": {
      "schema": "WasteEntry",
